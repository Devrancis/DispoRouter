generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Buyer {
  id              String   @id @default(cuid())
  userId          String   
  name            String
  budgetMax       Int      
  floodZone       String   
  requiresSeawall Boolean  @default(false)
  minSqFt         Int      
}

model PropertySubmission {
  id              String   @id @default(cuid())
  userId          String   
  apn             String   
  askingPrice     Int
  floodZone       String
  hasSeawall      Boolean
  sqFt            Int
  status          String   @default("PENDING") 
}