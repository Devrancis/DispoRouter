// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Buyer {
  id              String   @id @default(cuid())
  name            String
  budgetMax       Int      
  floodZone       String   
  requiresSeawall Boolean  @default(false)
  minSqFt         Int      
}

model PropertySubmission {
  id              String   @id @default(cuid())
  apn             String   
  askingPrice     Int
  floodZone       String
  hasSeawall      Boolean
  sqFt            Int
  status          String   @default("PENDING") 
}